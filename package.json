{
  "name": "solana-trust-layer",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time rug risk & deployer reputation platform for Solana",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter=./packages/* --filter=./services/* build",
    "dev:ingest": "pnpm --filter @solana-trust-layer/ingest dev",
    "dev:api": "pnpm --filter @solana-trust-layer/api dev",
    "dev:web": "pnpm --filter @solana-trust-layer/web dev",
    "dev:x-bot": "pnpm --filter @solana-trust-layer/x-bot dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "backtest": "pnpm --filter @solana-trust-layer/ingest backtest",
    "db:migrate": "pnpm --filter @solana-trust-layer/db migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/node": "^20.16.11"
  }
}
