# ── Solana / RPC ──────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_CLUSTER=devnet

# ── Birdeye ───────────────────────────────────────────────────
BIRDEYE_API_KEY=
BIRDEYE_RATE_LIMIT_RPS=15

# ── Database (Supabase Postgres) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Cache / Queue ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Token gating ──────────────────────────────────────────────
# Devnet dummy mint until the real token launches
TRUST_TOKEN_MINT=
HOLDER_TIER_MIN_BALANCE=1000000
API_PRO_TIER_MIN_BALANCE=10000000
BALANCE_RECHECK_INTERVAL_HOURS=8
BALANCE_GRACE_PERIOD_HOURS=24

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=7d
AUTH_NONCE_TTL_SECONDS=300

# ── Billing ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PAID=

# ── Receipts / Merkle ─────────────────────────────────────────
RECEIPTS_WALLET_PRIVATE_KEY=
RECEIPTS_MERKLE_JOB_CRON=0 * * * *

# ── X (Twitter) bot ───────────────────────────────────────────
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_BOT_USER_ID=
X_REPLY_BUDGET_PER_DAY=

# ── Service ports ─────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173

NODE_ENV=development
