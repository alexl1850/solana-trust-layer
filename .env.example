# ── Solana / RPC ──────────────────────────────────────────────
HELIUS_API_KEY=
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
HELIUS_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_CLUSTER=devnet

# ── Birdeye ───────────────────────────────────────────────────
BIRDEYE_API_KEY=
BIRDEYE_RATE_LIMIT_RPS=15

# ── Multi-chain early-volume / pre-FOMO alerts (detect-and-alert only —
# see PROJECT.md hard rule 1, this never places an order or holds a wallet
# key). DexScreener's API is free/unauthenticated, no key needed. Each EVM
# chain's WSS URL is optional: leave blank to disable live pair discovery
# on that chain (the rest of the platform is unaffected). Factory addresses
# below are well-known, unchanging deployment constants but are
# overridable — verify against each protocol's official docs before
# production use.
DEXSCREENER_RATE_LIMIT_RPS=5
ETHEREUM_WSS_URL=
ETHEREUM_UNISWAP_V2_FACTORY=0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
ETHEREUM_UNISWAP_V3_FACTORY=0x1F98431c8aD98523631AE4a59f267346ea31F984
BASE_WSS_URL=
BASE_UNISWAP_V2_FACTORY=
BASE_UNISWAP_V3_FACTORY=0x33128a8fC17869897dcE68Ed026d694621f6FDfD
BSC_WSS_URL=
BSC_PANCAKESWAP_V2_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73
BSC_PANCAKESWAP_V3_FACTORY=

# ── Database (Supabase Postgres) ─────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ── Cache / Queue ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Token gating ──────────────────────────────────────────────
# Devnet dummy mint until the real token launches
TRUST_TOKEN_MINT=
HOLDER_TIER_MIN_BALANCE=1000000
API_PRO_TIER_MIN_BALANCE=10000000
BALANCE_RECHECK_INTERVAL_HOURS=8
BALANCE_GRACE_PERIOD_HOURS=24

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRY=7d
AUTH_NONCE_TTL_SECONDS=300

# ── Billing ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PAID=

# ── Receipts / Merkle ─────────────────────────────────────────
RECEIPTS_WALLET_PRIVATE_KEY=
RECEIPTS_MERKLE_JOB_CRON=0 * * * *

# ── X (Twitter) bot ───────────────────────────────────────────
# Posting (receipts auto-post) works on X's free tier — leave X_ENABLE_MENTION_REPLIES
# off until you're ready to pay for read access (Basic tier+, needed to see @mentions).
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_ENABLE_MENTION_REPLIES=false
X_BOT_USER_ID=
X_REPLY_BUDGET_PER_DAY=
REPORT_BASE_URL=https://app.solanatrustlayer.com

# ── Service ports ─────────────────────────────────────────────
API_PORT=3000
WEB_PORT=5173

NODE_ENV=development
